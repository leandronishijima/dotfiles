#!/bin/bash

# kitty
ln -s ~/.dotfiles/.config/kitty/kitty.conf $HOME/.config/kitty/kitty.conf

# neofetch
ln -s ~/.dotfiles/neofetch/config.conf $HOME/.config/neofetch/config.conf

# tmux
ln -s ~/.dotfiles/.tmux.conf $HOME/.tmux.conf

# zsh p10k
ln -s ~/.dotfiles/zsh/.zshrc $HOME/.zshrc
ln -s ~/.dotfiles/zsh/.p10k.zsh $HOME/.p10k.zsh

# ranger
ln -s ~/.dotfiles/.config/ranger/rc.conf $HOME/.config/ranger/rc.conf

# solargraph
ln -s ~/.dotfiles/.config/solargraph/config.yml $HOME/.config/solargraph/config.yml

# git
ln -s ~/.dotfiles/.gitconfig $HOME/.gitconfig

# Lazygit
ln -s ~/.dotfiles/lazygit/config.yml ~/Library/Application\ Support/lazygit/config.yml

# asdf-ruby default-gems
ln -s ~/.dotfiles/.default-gems $HOME/.default-gems
ln -s ~/asdf/.asdfrc $HOME/.asdfrc

# mise
ln -s ~/.dotfiles/mise/config.toml $HOME/.config/mise/config.toml

# Zellij
ln -s ~/.dotfiles/zellij/config.kdl $HOME/.config/zellij/config.kdl
ln -s ~/.dotfiles/zellij/themes/themes.kdl $HOME/.config/zellij/themes/themes.kdl

# Wezterm
ln -s ~/.dotfiles/wezterm/wezterm.lua $HOME/.wezterm.lua

# Atuin
rm $HOME/.config/atuin/config.toml && ln -s ~/.dotfiles/.config/atuin/config.toml $HOME/.config/atuin/c
onfig.toml

# Ghostty
ln -s ~/.dotfiles/.config/ghostty/config $HOME/.config/ghostty/config

# Aerospace
ln -s ~/.dotfiles/aerospace/.aerospace.toml $HOME/.aerospace.toml

# Sketchybar
ln -s ~/.dotfiles/sketchybar/sketchybarrc $HOME/.config/sketchybar/sketchybarrc
ln -s ~/.dotfiles/sketchybar/colors.sh $HOME/.config/sketchybar/colors.sh
ln -s ~/.dotfiles/sketchybar/icons.sh $HOME/.config/sketchybar/icons.sh
ln -s ~/.dotfiles/sketchybar/plugins/ $HOME/.config/sketchybar/
ln -s ~/.dotfiles/sketchybar/items/ $HOME/.config/sketchybar/
ln -s ~/.dotfiles/sketchybar/helper/ $HOME/.config/sketchybar/
