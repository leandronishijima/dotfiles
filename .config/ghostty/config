# https://ghostty.org/docs/config/reference

theme = "Ayu Mirage"

clipboard-paste-protection = false

# Window customization
window-decoration = none
window-vsync = true
window-padding-x = 5
window-padding-y = 5
window-save-state = always

shell-integration-features = no-title

# MacOS specific settings
macos-option-as-alt = true
macos-titlebar-style = hidden

# UI
cursor-style = block
cursor-style-blink = true

# Fonts configuration
font-size = 11
font-thicken = true
font-family = "JetBrainsMono Nerd Font"

# font-synthetic-style = bold
# font-style = bold
# font-family-italic = "VictorMono Nerd Font Mono"
# font-family-bold-italic = "VictorMono NFM Bold Italic"

# Keybinds
keybind = ctrl+p>w=toggle_quick_terminal

keybind = ctrl+p>\=new_split:right
keybind = ctrl+p>f=toggle_split_zoom
keybind = ctrl+p>-=new_split:down

## Tabs commands
keybind = ctrl+option+l=next_tab
keybind = ctrl+option+h=previous_tab

## Split move commands
keybind = ctrl+p>h=goto_split:left
keybind = ctrl+p>l=goto_split:right
keybind = ctrl+p>j=goto_split:bottom
keybind = ctrl+p>k=goto_split:top

## Split resize commands
keybind = ctrl+n>0=equalize_splits
keybind = ctrl+n>h=resize_split:left,30
keybind = ctrl+n>l=resize_split:right,30
keybind = ctrl+n>j=resize_split:down,20
keybind = ctrl+n>k=resize_split:up,20

## Unbind fullscreen command
keybind = global:cmd+enter=unbind
