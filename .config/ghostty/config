theme = "Ayu Mirage"

# Window customization
window-decoration = false
window-vsync = true
window-save-state = always
window-padding-x = 25
window-padding-y = 25

# MacOS specific settings
macos-option-as-alt = true
macos-titlebar-style = hidden

# Fonts configuration
font-size = 11
font-thicken = true
font-family = "JetBrainsMono Nerd Font"

